{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kyivstart-requests",
	"main": "src/index.js",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	"triggers": {
		// щохвилини — черга геокодингу; 01:00 UTC — прибирання старих заявок
		"crons": [
			"* * * * *",
			"0 1 * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kyivstar-bot",
			"database_id": "5ab6fab9-8ef2-4915-94e0-3004c560767f",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Telegram ID адміністраторів через кому
		"ADMIN_IDS": "495476473, 488246980"
	}
}